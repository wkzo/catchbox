# ---- Environment template (no secrets committed) ----
NODE_ENV=production
DOMAIN=example.com
APP_URL=https://mail.example.com
WEB_ORIGIN=https://mail.example.com

API_HOST=0.0.0.0
API_PORT=8800

DATABASE_URL=postgres://quit:CHANGE_ME@postgres:5432/quit_mail
REDIS_URL=redis://redis:6379

# Object storage: fs (local) or s3 (MinIO/S3)
STORE_DRIVER=s3
STORE_FS_PATH=/data/store
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=catchbox-mail
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# Auth
SESSION_SECRET=CHANGE_ME_32_BYTES
SESSION_COOKIE=quit_sid
SESSION_TTL_DAYS=30
CSRF_COOKIE=quit_csrf

# Inbound LMTP (worker)
LMTP_HOST=0.0.0.0
LMTP_PORT=10025
SMTP_HOSTNAME=mail.example.com

# Outbound transport: self_hosted | ses | postmark | resend
MAIL_TRANSPORT=self_hosted
SELF_HOSTED_SMTP_HOST=postfix
SELF_HOSTED_SMTP_PORT=25
# SES_REGION=
# SES_ACCESS_KEY=
# SES_SECRET_KEY=
# POSTMARK_TOKEN=
# RESEND_API_KEY=

# DKIM signing key (worker). Generate with scripts in infrastructure/dkim.
DKIM_SELECTOR=quit
DKIM_PRIVATE_KEY_PATH=/dkim/quit.private.key

# Optional spam/virus checks
# RSPAMD_URL=http://rspamd:11334
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

MAX_MESSAGE_BYTES=26214400
MAX_ATTACHMENT_BYTES=15728640
MAX_OUTBOUND_PER_DAY=200

PUBLIC_IP=203.0.113.10
